<?xml version="1.0" encoding="UTF-8"?>
<!-- SYNTHETIC：合法 RSS 结构但零 <item>——program 某周无新论文时的真实可能形态（模拟
     back.nber.org/rss/new{code}.xml 冷门 program 的空周），非畸形：parse 侧须返回空
     元组而非报错（"零新增"是合法结果，不是异常——design/09 §6 日报"空日"场景在 RSS
     watch 侧的对应输入）。 -->
<rss version="2.0">
  <channel>
    <title>NBER New Working Papers</title>
    <link>https://www.nber.org/</link>
    <description>Recently posted NBER working papers</description>
  </channel>
</rss>
