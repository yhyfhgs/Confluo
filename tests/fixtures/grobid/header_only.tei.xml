<?xml version="1.0" encoding="UTF-8"?>
<!-- L3 负例（§6.1 P0-2 的回归锁语料）：GROBID 对 image-only PDF 的真实产物形态——
     HTTP 200、XML 语法合法、TEI 根正确，但 <text> 里**可见文本为零**（只有空的结构骨架）。
     若按「200 且 XML 合法」判成功，该产物会以 rank 2 压制同 paper 已有的 pypdf 正文——
     一次「增强」反而抹掉基线成果。故它必须与「服务不可用」同路径处置（→ 纯文本兜底）。 -->
<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:lang="en">
  <teiHeader>
    <fileDesc>
      <titleStmt>
        <title level="a" type="main">Scanned Proceedings Volume</title>
      </titleStmt>
    </fileDesc>
  </teiHeader>
  <text xml:lang="en">
    <front/>
    <body/>
    <back/>
  </text>
</TEI>
