<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd 模板（macOS）——post-phase5-audit §3[S4]/§6 处置 4："canary 周跑自动化载体"。

  这是一份**模板**，不是可直接 load 的成品：本仓库/agent 不会替你安装任何持久化
  任务（不常驻、不改 CI）。使用前必须手动完成三步替换与安装：

    1. 把下面两处 __REPO_ROOT__ 替换成你本机 clone 本仓库的绝对路径
       （例如 /Users/you/code/paper-crawler，不要带结尾斜杠）。
    2. 把两处 __LOG_DIR__ 替换成你希望存放日志的目录的绝对路径
       （建议 $HOME/.paper-crawler/logs，需自行确保目录存在，
       如 `mkdir -p ~/.paper-crawler/logs`）。
    3. 另存为 ~/Library/LaunchAgents/com.papercrawler.canary-weekly.plist
       （去掉 .template 后缀），然后：
         launchctl load ~/Library/LaunchAgents/com.papercrawler.canary-weekly.plist

  卸载：
    launchctl unload ~/Library/LaunchAgents/com.papercrawler.canary-weekly.plist
    rm ~/Library/LaunchAgents/com.papercrawler.canary-weekly.plist

  完整步骤与排错见 docs/testing/records/canary/README.md
  "本地周跑自动化（launchd/cron 模板）"一节。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.papercrawler.canary-weekly</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO_ROOT__/scripts/canary_weekly.sh</string>
  </array>

  <!-- 周日本地时间 03:00——test-plan.md §5"auth 族 canary 每周一次且避开工作日
       高峰"的保守选择；改这三个整数即可调整到你喜欢的时间。 -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>0</integer>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <!-- 刻意为 false：这是一次会对多个真实站点发请求的周跑，不希望每次登录/
       重启都意外触发一次；只在上面声明的每周固定时刻跑。 -->
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>__LOG_DIR__/canary-weekly.out.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/canary-weekly.err.log</string>
</dict>
</plist>
