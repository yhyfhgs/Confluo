# ---- 凭证与会话（绝不入库）----
credentials/
*.credential
*.secret
storage_state*.json
auth_profiles/
.env
.env.*

# ---- 项目级配置（D-025；仅非敏感键，敏感键有启动护栏，此为双保险防误提交）----
paper-crawler.toml

# ---- 下载产物（体积大且有版权，绝不入库）----
data/
downloads/
*.pdf
!docs/**/*.pdf-placeholder

# ---- 运行时 ----
*.log
*.sqlite
*.sqlite3
*.db
__pycache__/
*.pyc
.venv/
venv/
node_modules/

# ---- 系统与编辑器 ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ---- 测试快照的临时重录区（正式 fixtures 会入库）----
tests/fixtures/_staging/
# 每 adapter 的重录暂存区（如 arxiv 的 scripts/record_arxiv_fixtures.py 落 _staging）
tests/fixtures/*/_staging/

# ---- Phase 1 实现阶段增补（工具产物，绝不入库）----
.coverage
.coverage.*
htmlcov/
# SQLite WAL 副本文件（journal_mode=WAL）
*.sqlite-wal
*.sqlite-shm
# 质量工具缓存
.mypy_cache/
.ruff_cache/
.pytest_cache/
# subagent 工作目录
.superpowers/
